# Upvalue bubbling through intermediate functions.
# A closure that captures a variable two or more levels up must thread a
# forwarding upvalue through every function in between.

def nested_call():
    x = 1
    def middle():
        def inner():
            return x
        return inner()
    return middle()

print("nested call:", nested_call())        # 1

def returned_closure():
    x = 42
    def middle():
        def inner():
            return x
        return inner
    return middle()()

print("returned closure:", returned_closure())   # 42

def four_levels():
    a = 1
    def l2():
        b = 2
        def l3():
            c = 3
            def l4():
                return a + b + c
            return l4()
        return l3()
    return l2()

print("four levels:", four_levels())        # 6

def two_owners():
    x = 10
    def mid():
        y = 20
        def inner():
            return x * 100 + y
        return inner()
    return mid()

print("two owners:", two_owners())          # 1020

def siblings():
    n = 0
    def inc():
        return n + 1
    def dec():
        return n - 1
    return inc() + dec()

print("siblings:", siblings())              # 0

def deep_global_write():
    def mid():
        def inner():
            global DEEP
            DEEP = 100
        inner()
    mid()
    return DEEP

print("deep global write:", deep_global_write())   # 100
